# Copy this file to .env and fill in real values. Do NOT commit .env.
#   cp .env.example .env

# ============ DJANGO CORE ============
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# True for local development ONLY. Production must run with DEBUG=False.
DEBUG=True
# Comma-separated hostnames. Defaults to the Render domain + localhost when unset.
ALLOWED_HOSTS=

# ============ ADMIN USER (set these to auto-create superuser on Render) ============
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ============ DATABASE ============
# Blank = local SQLite. On Render this is provided automatically.
DATABASE_URL=

# ============ SITE ============
# Must be the public URL in production; payment gateways redirect back here.
SITE_BASE_URL=http://127.0.0.1:8000

# ============ CLOUDINARY ============
# Dashboard > Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ============ EMAIL (Mailgun SMTP) ============
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mailgun.org
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# ============ ESEWA ============
# Sandbox defaults are eSewa's public test values.
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=
ESEWA_FORM_URL=https://rc-epay.esewa.com.np/api/epay/main/v2/form
ESEWA_STATUS_URL=https://rc-epay.esewa.com.np/api/epay/transaction/status/

# ============ KHALTI ============
# Get a test key from dev.khalti.com
KHALTI_SECRET_KEY=
KHALTI_INITIATE_URL=https://dev.khalti.com/api/v2/epayment/initiate/
KHALTI_LOOKUP_URL=https://dev.khalti.com/api/v2/epayment/lookup/
